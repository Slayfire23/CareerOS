// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  supabaseAuthId String         @unique @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  careerProfile  CareerProfile?
  savedJobs SavedJob[]
  /// Explicit consent to send job or profile text to a cloud AI provider. Null means no consent.
  /// Not needed for the local deterministic rules engine; enforced before any cloud provider.
  aiCloudConsentAt DateTime? @db.Timestamptz(3)
  /// Which consent text the user accepted; a new provider, model family, or field list bumps it.
  aiCloudConsentVersion Int?
  aiAnalysisRuns   AiAnalysisRun[]
  jobMatchAnalyses JobMatchAnalysis[]
}

model SavedJob {
 requirements Json @default("[]")
 reviewedDescription String? @db.VarChar(30000)
 reviewVersion Int @default(0)
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 title String @db.VarChar(200)
 company String @db.VarChar(200)
 postingUrl String? @db.VarChar(2000)
 description String @db.VarChar(30000)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 aiAnalysisRuns AiAnalysisRun[]
 jobMatchAnalyses JobMatchAnalysis[]
 @@index([userId, createdAt])
 // Lets JobMatchAnalysis reference (job, owner) so the database rejects cross-account links.
 @@unique([id, userId])
}

model CareerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String   @db.VarChar(100)
  headline    String?  @db.VarChar(200)
  careerGoals String?
  targetRoles String[] @default([])
  industries String[] @default([])
  workArrangements String[] @default([])
  employmentTypes String[] @default([])
  preferredLocations String[] @default([])
  relocationWillingness String? @db.VarChar(10)
  maxCommuteMinutes Int?
  salaryMinCents Int?
  salaryMaxCents Int?
  salaryCurrency String? @db.VarChar(3)
  salaryPeriod String? @db.VarChar(5)
  technicalSkills TechnicalSkill[]
  professionalExperiences ProfessionalExperience[]
  educationEntries Education[]
  projects ProjectAccomplishment[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model TechnicalSkill {
  id String @id @default(uuid()) @db.Uuid
  profileId String @db.Uuid
  name String @db.VarChar(100)
  normalizedName String @db.VarChar(100)
  proficiency SkillProficiency?
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, normalizedName])
}

model ProfessionalExperience {
 id String @id @default(uuid()) @db.Uuid
 profileId String @db.Uuid
 jobTitle String @db.VarChar(100)
 company String @db.VarChar(100)
 startMonth String @db.VarChar(7)
 endMonth String? @db.VarChar(7)
 description String? @db.VarChar(5000)
 profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
 @@index([profileId])
}

model Education {
 id String @id @default(uuid()) @db.Uuid
 profileId String @db.Uuid
 qualification String @db.VarChar(100)
 institution String @db.VarChar(100)
 startMonth String @db.VarChar(7)
 endMonth String? @db.VarChar(7)
 fieldOfStudy String? @db.VarChar(100)
 description String? @db.VarChar(5000)
 profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
 @@index([profileId])
}

model ProjectAccomplishment {
 id String @id @default(uuid()) @db.Uuid
 profileId String @db.Uuid
 title String @db.VarChar(100)
 description String? @db.VarChar(5000)
 contribution String? @db.VarChar(5000)
 results String? @db.VarChar(5000)
 skills String[] @default([])
 links String[] @default([])
 profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
 @@index([profileId])
}

enum AiAnalysisStatus {
  STARTED
  SUCCEEDED
  FAILED
}

/// NONE: local provider, no cost. RESERVED: call in flight, worst case held. CONFIRMED: charge
/// computed from provider-reported usage. UNRESOLVED: may have been billed, worst case held until
/// reconciled. RELEASED: the provider did not process the request, nothing held.
enum AiBillingState {
  NONE
  RESERVED
  CONFIRMED
  UNRESOLVED
  RELEASED
}

/// One row per analysis attempt, used for the daily limit, history, and audit.
/// Metadata only: no job, profile, or finding text.
model AiAnalysisRun {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  /// Becomes null if the job is deleted, so the daily limit and audit trail survive.
  savedJobId String?          @db.Uuid
  status     AiAnalysisStatus @default(STARTED)
  provider   String           @db.VarChar(40)
  /// Machine-readable code only (e.g. "service_unavailable"), never message text.
  errorCode  String?          @db.VarChar(60)
  startedAt  DateTime         @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?        @db.Timestamptz(3)
  /// False only for failures that never reached an analysis (service down, provider busy).
  countsTowardLimit Boolean @default(true)
  model             String?  @db.VarChar(60)
  /// Cost ledger (cloud providers). Amounts are micro-USD. A reservation is the worst case for
  /// one call; it is held until the charge is confirmed from provider-reported usage, released
  /// (not billed), or reconciled by hand. Estimates are never recorded as confirmed charges.
  billingState      AiBillingState @default(NONE)
  reservedMicroUsd  Int            @default(0)
  confirmedMicroUsd Int?
  inputTokens       Int?
  outputTokens      Int?
  cacheReadTokens   Int?
  cacheWriteTokens  Int?
  providerRequestId String?  @db.VarChar(100)
  reconciledAt      DateTime? @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedJob   SavedJob?        @relation(fields: [savedJobId], references: [id], onDelete: SetNull)
  analysis   JobMatchAnalysis?

  @@index([userId, startedAt])
  @@index([savedJobId, startedAt])
  /// Global budget sums across all users.
  @@index([startedAt, billingState])
  @@unique([id, userId])
}

/// A validated analysis of one saved job's reviewed requirements against the owner's profile.
model JobMatchAnalysis {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  savedJobId          String        @db.Uuid
  runId               String        @unique @db.Uuid
  /// The SavedJob.reviewVersion analysed. A later review makes this analysis out of date.
  requirementsVersion Int
  /// SHA-256 of the evidence sent. A changed profile makes this analysis out of date.
  profileFingerprint  String        @db.Char(64)
  provider            String        @db.VarChar(40)
  model               String?       @db.VarChar(100)
  methodVersion       String        @db.VarChar(40)
  /// Snapshot of the reviewed requirements that were analysed (the owner's own job data).
  requirements        Json
  findings            Json
  verdictCounts       Json
  /// The owner's Agree/Disagree feedback, keyed by requirement index.
  feedback            Json          @default("{}")
  feedbackVersion     Int           @default(0)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Composite reference: the analysed job must belong to the same user.
  savedJob            SavedJob      @relation(fields: [savedJobId, userId], references: [id, userId], onDelete: Cascade)
  /// Composite reference: the run must belong to the same user.
  run                 AiAnalysisRun @relation(fields: [runId, userId], references: [id, userId], onDelete: Cascade)

  @@index([savedJobId, createdAt])
  @@index([userId, createdAt])
  @@unique([runId, userId])
}
