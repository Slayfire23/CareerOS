// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  supabaseAuthId String         @unique @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  careerProfile  CareerProfile?
}

model CareerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String   @db.VarChar(100)
  headline    String?  @db.VarChar(200)
  careerGoals String?
  targetRoles String[] @default([])
  industries String[] @default([])
  workArrangements String[] @default([])
  employmentTypes String[] @default([])
  preferredLocations String[] @default([])
  relocationWillingness String? @db.VarChar(10)
  maxCommuteMinutes Int?
  salaryMinCents Int?
  salaryMaxCents Int?
  salaryCurrency String? @db.VarChar(3)
  salaryPeriod String? @db.VarChar(5)
  technicalSkills TechnicalSkill[]
  professionalExperiences ProfessionalExperience[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model TechnicalSkill {
  id String @id @default(uuid()) @db.Uuid
  profileId String @db.Uuid
  name String @db.VarChar(100)
  normalizedName String @db.VarChar(100)
  proficiency SkillProficiency?
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, normalizedName])
}

model ProfessionalExperience {
 id String @id @default(uuid()) @db.Uuid
 profileId String @db.Uuid
 jobTitle String @db.VarChar(100)
 company String @db.VarChar(100)
 startMonth String @db.VarChar(7)
 endMonth String? @db.VarChar(7)
 description String? @db.VarChar(5000)
 profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
 @@index([profileId])
}
