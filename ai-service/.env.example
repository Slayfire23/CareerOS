# Copy to ai-service/.env for local development. Never commit real values.
AI_ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_SECRET=replace-with-a-long-random-value
AI_PROVIDER=rules
AI_SIGNATURE_MAX_AGE_SECONDS=300
AI_PROVIDER_TIMEOUT_SECONDS=40
# Phase 3 (not used yet): cloud model for the Anthropic provider.
AI_ANTHROPIC_MODEL=claude-sonnet-5-5
